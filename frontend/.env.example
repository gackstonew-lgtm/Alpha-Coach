# =============================================================================
# Alpha Coach Frontend - Environment Configuration Template
# =============================================================================
# Supabase Client-Side Configuration (Browser-safe Publishable/Anon key only)
# NEVER put service_role or secret keys in VITE_* variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# Backend API URL:
# - Leave empty or unset to use relative '/api/v1' (automatically proxied in dev and routed in prod)
# - For mobile device testing over LAN without proxy, set to e.g. http://<YOUR_LAN_IP>:4000/api/v1
# VITE_API_URL=http://localhost:4000/api/v1
