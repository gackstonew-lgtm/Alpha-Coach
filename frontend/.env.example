# =============================================================================
# Alpha Coach Frontend - Environment Configuration Template
# =============================================================================
# Supabase Client-Side Configuration (Browser-safe Publishable/Anon key only)
# NEVER put service_role or secret keys in VITE_* variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# Optional Custom Backend API URL (Leave empty for pure Supabase client architecture)
# VITE_API_URL=http://localhost:4000/api/v1
