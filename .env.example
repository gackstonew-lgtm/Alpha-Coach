# =============================================================================
# Alpha Coach - Master Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your production or development values.
# DO NOT commit real secrets, private keys, or passwords to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Cloud Backend Configuration
# -----------------------------------------------------------------------------
# Supabase Project URL (e.g., https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Public Key (Safe for frontend/browser use)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-jwt
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-jwt
SUPABASE_ANON_KEY=your-supabase-publishable-key-or-anon-jwt
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-or-anon-jwt

# Supabase Secret / Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SECRET_KEY=your-supabase-secret-key-or-service-role-jwt
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-or-service-role-jwt

# Optional Direct PostgreSQL Connection String (Supabase Postgres Pooler or Direct)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Security: JWT Signing Secret for Alpha Coach Auth
JWT_SECRET=alpha-coach-super-secure-production-secret-key-2026

# Local Data Storage & SQLite Database (Zero-config local fallback / testing)
DATA_DIR=./data
DB_PATH=./data/alphacoach.sqlite

# -----------------------------------------------------------------------------
# Frontend Client Configuration
# -----------------------------------------------------------------------------
# URL where Alpha Coach Backend API is accessible from the frontend
VITE_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# Local MT5 Bridge Configuration
# -----------------------------------------------------------------------------
# The Alpha Coach Backend API URL for the bridge to connect to
MT5_BRIDGE_API_URL=http://localhost:4000/api/v1

# Device pairing token generated from Alpha Coach Dashboard (Settings -> MT5 Bridge)
# MT5_BRIDGE_DEVICE_TOKEN=your_device_pairing_token_here
