# =============================================================================
# Alpha Coach - Environment Configuration Template
# =============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# DO NOT commit real secrets, private keys, or passwords to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Security: Set a strong random secret key (e.g., openssl rand -base64 32)
JWT_SECRET=your_strong_random_jwt_secret_here

# Local Data Storage & SQLite Database
DATA_DIR=./data
DB_PATH=./data/alphacoach.sqlite

# Optional: PostgreSQL Database Connection String (if running PostgreSQL)
# DATABASE_URL=postgresql://alphacoach_user:alphacoach_password@localhost:5432/alphacoach

# -----------------------------------------------------------------------------
# Frontend Client Configuration
# -----------------------------------------------------------------------------
# URL where Alpha Coach Backend API is accessible from the frontend
VITE_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# Local MT5 Bridge Configuration (Optional Environment Overrides)
# -----------------------------------------------------------------------------
# The Alpha Coach Backend API URL for the bridge to connect to
MT5_BRIDGE_API_URL=http://localhost:4000/api/v1

# Device pairing token generated from Alpha Coach Dashboard (Settings -> MT5 Bridge)
# MT5_BRIDGE_DEVICE_TOKEN=your_device_pairing_token_here
