# =============================================================================
# Alpha Coach - Root Environment Variables Template
# =============================================================================
PORT=4000
NODE_ENV=development

# Security Secret (Replace with secure random 32+ character string)
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Supabase Production Configuration (Authoritative Project URL & Public Key)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-jwt

# Supabase Backend Secret (Never expose to frontend or browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Optional Custom Backend URL for Frontend (Leave empty in pure Supabase mode)
# VITE_API_URL=http://localhost:4000/api/v1
# MT5_BRIDGE_API_URL=http://localhost:4000/api/v1

# Local Database Fallback (For offline backend operation)
DATA_DIR=./data
DB_PATH=./data/alphacoach.sqlite
