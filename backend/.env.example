# =============================================================================
# Alpha Coach Backend - Environment Configuration Template
# =============================================================================
PORT=4000
NODE_ENV=development

# Security
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Supabase Server-Side Configuration (Read from environment only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key-or-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-or-service-role-jwt
SUPABASE_SECRET_KEY=your-supabase-secret-key-or-service-role-jwt

# Optional Direct PostgreSQL Connection (Supabase Postgres)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Local SQLite Fallback Database
DATA_DIR=../data
DB_PATH=../data/alphacoach.sqlite
